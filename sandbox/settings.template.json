{
  "autoMemoryEnabled": false,
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": ["github.com", "naif.jpl.nasa.gov", "numpy.org", "pandas.pydata.org", "pytest.org", "docs.python.org",
        "docs.xarray.dev", "cloudpathlib.drivendata.org", "space-packet-parser.readthedocs.io", "docs.sqlalchemy.org",
        "docs.h5py.org", "docs.pydantic.dev", "pydantic.dev", "boto3.amazonaws.com", "docs.aws.amazon.com"],
      "allowLocalBinding": true
    },
    "filesystem": {"denyWrite": ["/{sandbox}/settings.json", "/{sandbox}/mcp.json"], "allowWrite": ["/tmp", "/private/tmp"]},
    "credentials": {
      "files": [
        {"path": "~/.config/gh", "mode": "deny"},
        {"path": "~/.git-credentials", "mode": "deny"},
        {"path": "~/.netrc", "mode": "deny"}
      ],
      "envVars": [
        {"name": "GH_TOKEN", "mode": "deny"},
        {"name": "GITHUB_TOKEN", "mode": "deny"},
        {"name": "SBX_FIXTURES", "mode": "deny"}
      ]
    }
  },
  "permissions": {
    "allow": [
      "Read(//{sandbox}/**)",
      "Read(//{plugin}/**)",
      "Edit(//{sandbox}/**)",
      "Write(//{sandbox}/**)",
      "Glob",
      "Grep",
      "Agent",
      "Skill",
      "TodoWrite",
      "ToolSearch",
      "mcp__{atlassian}",
      "mcp__{github}__get_commit",
      "mcp__{github}__get_file_contents",
      "mcp__{github}__get_label",
      "mcp__{github}__get_latest_release",
      "mcp__{github}__get_me",
      "mcp__{github}__get_tag",
      "mcp__{github}__issue_read",
      "mcp__{github}__list_branches",
      "mcp__{github}__list_commits",
      "mcp__{github}__list_issue_fields",
      "mcp__{github}__list_issue_types",
      "mcp__{github}__list_issues",
      "mcp__{github}__list_pull_requests",
      "mcp__{github}__list_releases",
      "mcp__{github}__list_tags",
      "mcp__{github}__pull_request_read",
      "mcp__{github}__search_code",
      "mcp__{github}__search_issues",
      "mcp__{github}__search_pull_requests",
      "mcp__{github}__search_repositories",
      "mcp__{github}__search_users",
      "Bash(*)"
    ],
    "deny": [
      "Edit(//{sandbox}/settings.json)",
      "Write(//{sandbox}/settings.json)",
      "Edit(//{sandbox}/mcp.json)",
      "Write(//{sandbox}/mcp.json)",
      "mcp__{github}__add_comment_to_pending_review",
      "mcp__{github}__add_issue_comment",
      "mcp__{github}__add_reply_to_pull_request_comment",
      "mcp__{github}__assign_copilot_to_issue",
      "mcp__{github}__create_branch",
      "mcp__{github}__create_or_update_file",
      "mcp__{github}__create_pull_request",
      "mcp__{github}__create_pull_request_with_copilot",
      "mcp__{github}__create_repository",
      "mcp__{github}__delete_file",
      "mcp__{github}__delete_repository",
      "mcp__{github}__fork_repository",
      "mcp__{github}__issue_write",
      "mcp__{github}__merge_pull_request",
      "mcp__{github}__pull_request_review_write",
      "mcp__{github}__push_files",
      "mcp__{github}__request_copilot_review",
      "mcp__{github}__run_secret_scanning",
      "mcp__{github}__sub_issue_write",
      "mcp__{github}__update_issue_comment",
      "mcp__{github}__update_pull_request",
      "mcp__{github}__update_pull_request_branch",
      "mcp__{atlassian}__jira_create_issue",
      "mcp__{atlassian}__jira_batch_create_issues",
      "mcp__{atlassian}__jira_update_issue",
      "mcp__{atlassian}__jira_delete_issue",
      "mcp__{atlassian}__jira_add_comment",
      "mcp__{atlassian}__jira_edit_comment",
      "mcp__{atlassian}__jira_add_worklog",
      "mcp__{atlassian}__jira_transition_issue",
      "mcp__{atlassian}__jira_link_to_epic",
      "mcp__{atlassian}__jira_create_issue_link",
      "mcp__{atlassian}__jira_remove_issue_link",
      "mcp__{atlassian}__jira_create_remote_issue_link",
      "mcp__{atlassian}__jira_create_sprint",
      "mcp__{atlassian}__jira_update_sprint",
      "mcp__{atlassian}__jira_add_issues_to_sprint",
      "mcp__{atlassian}__jira_create_version",
      "mcp__{atlassian}__jira_batch_create_versions",
      "mcp__{atlassian}__confluence_create_page",
      "mcp__{atlassian}__confluence_update_page",
      "mcp__{atlassian}__confluence_delete_page",
      "mcp__{atlassian}__confluence_add_label",
      "mcp__{atlassian}__confluence_add_comment",
      "mcp__{atlassian}__confluence_reply_to_comment",
      "mcp__{atlassian}__jira_add_watcher",
      "mcp__{atlassian}__jira_remove_watcher",
      "mcp__{atlassian}__jira_assign_issue",
      "mcp__{atlassian}__jira_move_issue",
      "mcp__{atlassian}__jira_move_issues_to_backlog",
      "mcp__{atlassian}__jira_create_customer_request",
      "mcp__{atlassian}__jira_update_version",
      "mcp__{atlassian}__jira_update_proforma_form_answers",
      "mcp__{atlassian}__confluence_update_page_section",
      "mcp__{atlassian}__confluence_move_page",
      "mcp__{atlassian}__confluence_add_inline_comment",
      "mcp__{atlassian}__confluence_upload_attachment",
      "mcp__{atlassian}__confluence_upload_attachments",
      "mcp__{atlassian}__confluence_delete_attachment",
      "mcp__{atlassian}__confluence_create_page_from_template",
      "mcp__{atlassian}__confluence_set_page_restrictions",
      "mcp__{atlassian}__confluence_copy_page",
      "Bash(git push*)",
      "Bash(*git push*)",
      "Bash(git -C * push*)",
      "Bash(gh *)",
      "Bash(aws *)",
      "Bash(curl *)",
      "Bash(claude *)"
    ]
  }
}
